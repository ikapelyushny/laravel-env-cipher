{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "strict_param": true,
        "void_return": true,
        "date_time_immutable": true,
        "concat_space": {"spacing": "one"},
        "not_operator_with_successor_space": false
    }
}
